rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /transwisataDocuments/{documentId} {
      // Anonymous users are allowed: effectively public to all visitors.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['documentType','date','customer','registration','aircraftType','sheetNo','dateEnd','filename','mime','storagePath','createdAt','updatedAt'])
        && request.resource.data.documentType in ['Flight Sheet','Passenger Manifest']
        && request.resource.data.customer is string
        && request.resource.data.customer.size() <= 300
        && request.resource.data.registration in ['PK-TWY','PK-TWX','PK-TWW','PK-TWV','PK-TWZ'];
      allow delete: if request.auth != null;
    }
  }
}
